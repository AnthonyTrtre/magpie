// Par défaut l'app est signée « ad hoc » (signature locale) : elle tourne sur le Mac qui la compile.
// Pour signer avec ton équipe Apple, crée Config/Signing.local.xcconfig (ignoré par git) contenant :
//   DEVELOPMENT_TEAM = ABCDE12345
//   CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
#include? "Signing.local.xcconfig"
